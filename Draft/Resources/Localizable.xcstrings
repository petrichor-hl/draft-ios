          "stringUnit" : {
            "state" : "translated",
            "value" : "Just declare the coefficient (its relation to the base unit) and the new unit can immediately convert to and from EVERY other length unit — via the canonical value."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Basta declarar el coefficient (su relación con la unidad base) y la nueva unidad podrá convertirse de inmediato con TODAS las demás unidades de longitud — a través del valor canónico."
          }
