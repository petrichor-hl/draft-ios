    "response" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "response"
          }
        }
      }
    },
    "response = độ \"cứng\" của lò xo, hiểu nôm na là bao lâu để đi hết một dao động. Nhỏ → nhanh và gắt, lớn → chậm và lười.\n\ndampingFraction = ma sát. 1.0 là tới đích rồi dừng, không nảy (critically damped). Càng nhỏ càng nảy qua nảy lại; thử 0.2 để thấy rõ." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "response = how “stiff” the spring is, roughly how long it takes to get through one oscillation. Smaller → fast and sharp, larger → slow and lazy.\n\ndampingFraction = friction. 1.0 means it reaches the target and stops, no bounce (critically damped). The smaller it gets, the more it bounces back and forth; try 0.2 to see it clearly."
          }
        }
      }
    },
